// Barra superior. Cada nombre en modules-* es un "módulo"; quita o reordena
// los que quieras. Lista completa: https://github.com/Alexays/Waybar/wiki
{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/otearia", "pulseaudio", "network", "battery", "tray"],

    // Otearia escribe su propio texto. "signal": 8 le permite pedir a la
    // barra que se redibuje al instante cuando llegan noticias.
    "custom/otearia": {
        "exec": "otearia barra",
        "return-type": "json",
        "interval": 120,
        "signal": 8,
        "on-click": "otearia ventana"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}"
    },

    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Silencio",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "Cable",
        "format-disconnected": "Sin red"
    },

    // En un equipo de escritorio o máquina virtual sin batería este módulo
    // simplemente no aparece.
    "battery": {
        "format": "Bat {capacity}%",
        "format-charging": "Cargando {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
