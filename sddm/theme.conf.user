# Ajustes de Itzli para la pantalla de inicio de sesión.
# SDDM lee este archivo después del theme.conf del tema y sus valores ganan.
# Así el tema original queda intacto y se puede actualizar sin perder esto.
[General]
Background="Backgrounds/itzli.jpg"
HeaderText="Itzli"
FormPosition="center"
HaveFormBackground="false"
PartialBlur="false"
Locale="es_MX"
DateFormat="dddd d 'de' MMMM"

HeaderTextColor="#ffffff"
DateTextColor="#c9d8f5"
TimeTextColor="#ffffff"
FormBackgroundColor="#070b14"
BackgroundColor="#070b14"
DimBackgroundColor="#070b14"
LoginFieldBackgroundColor="#101a30"
PasswordFieldBackgroundColor="#101a30"
LoginFieldTextColor="#ffffff"
PasswordFieldTextColor="#ffffff"
UserIconColor="#9ec5ff"
PasswordIconColor="#9ec5ff"
PlaceholderTextColor="#9ec5ff"
WarningColor="#ff2e88"
LoginButtonTextColor="#ffffff"
LoginButtonBackgroundColor="#2d7dff"
SystemButtonsIconsColor="#9ec5ff"
SessionButtonTextColor="#9ec5ff"
VirtualKeyboardButtonTextColor="#9ec5ff"
DropdownTextColor="#ffffff"
DropdownSelectedBackgroundColor="#2d7dff"
DropdownBackgroundColor="#101a30"
HighlightTextColor="#ffffff"
HighlightBackgroundColor="#2d7dff"
HighlightBorderColor="#2d7dff"
HoverUserIconColor="#00e5ff"
HoverPasswordIconColor="#00e5ff"
HoverSystemButtonsIconsColor="#00e5ff"
HoverSessionButtonTextColor="#00e5ff"
HoverVirtualKeyboardButtonTextColor="#00e5ff"

TranslatePlaceholderUsername="Usuario"
TranslatePlaceholderPassword="Contraseña"
TranslateLogin="Entrar"
TranslateLoginFailedWarning="Usuario o contraseña incorrectos"
TranslateCapslockWarning="Bloq Mayús está activado"
TranslateSuspend="Suspender"
TranslateHibernate="Hibernar"
TranslateReboot="Reiniciar"
TranslateShutdown="Apagar"
TranslateSessionSelection="Sesión"
